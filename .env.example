# Copy to .env and add your own keys. These are used only by the backend.
ANTHROPIC_API_KEY=
# Only needed when VISION_PROVIDER=openai
OPENAI_API_KEY=

# Pinned endpoints. .env overrides inherited env vars, so a proxy exported by the
# shell/user environment can't silently answer for these models.
ANTHROPIC_BASE_URL=https://api.anthropic.com
OPENAI_BASE_URL=https://api.openai.com/v1

# Which model reads the handwritten sheet (OCR + answer structuring): anthropic | openai
VISION_PROVIDER=anthropic
OPENAI_VISION_MODEL=gpt-4o
# Claude 3.5 Sonnet (claude-3-5-sonnet-20241022) was retired on 2025-10-28; this is the current Sonnet.
ANTHROPIC_MODEL=claude-sonnet-5-5

# OCR confidence below this (whole sheet, or any single page) routes the sheet to
# HUMAN_REVIEW_REQUIRED (BRD FR-2.4 default 0.70).
OCR_CONFIDENCE_THRESHOLD=0.70
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---------------------------------------------------------------------------------------
# Optional settings (defaults shown; uncomment to change). See API_CONTRACT.md "Settings".
# ---------------------------------------------------------------------------------------
# OCR cache by file SHA-256 (FR-2.5): re-uploading identical bytes reuses the stored OCR -
# "OCR cache hit - no vision call (Rs 0.00)". 1 = on, 0 = off.
# OCR_CACHE=1
# Pre-processing: PDF render DPI, longest edge sent to the vision model (800-2576),
# deskew + contrast + sharpen toggle, contrast factor (BRD says 1.8; 1.4 keeps faint pencil),
# minimum short edge before small photos are upscaled.
# PDF_MASTER_DPI=300
# VISION_MAX_EDGE_PX=2000
# PREPROCESS_ENHANCE=1
# PREPROCESS_CONTRAST=1.4
# MIN_SHORT_EDGE_PX=1200
# Worker: attempts for transient AI errors, exponential backoff base (seconds), parallel jobs.
# MAX_JOB_ATTEMPTS=3
# RETRY_BACKOFF_BASE_SECONDS=2.0
# WORKER_CONCURRENCY=4
# Cost tracking: USD->INR rate, per-student cost target (Rs), latency targets (seconds).
# USD_INR=85
# COST_TARGET_INR=5
# LATENCY_TARGET_SECONDS=300
# BATCH_TARGET_SECONDS=1800
# Override LLM prices (USD per million tokens), e.g.
# LLM_PRICING_JSON='{"claude-sonnet-5-5": {"input": 2, "output": 10, "cache_write_5m": 2.5, "cache_read": 0.1}}'
# Study plan: target exam, ASSUMED exam date (shown as "assumed" until a batch date is set),
# weekly study hours.
# DEFAULT_EXAM=NEET
# NEET_EXAM_DATE=2027-05-02
# STUDY_HOURS_PER_WEEK=18
# Report delivery. WhatsApp is always SIMULATED in this PoC (nothing is sent):
# blocked = template pending approval; simulate = simulated, not sent.
# WHATSAPP_MODE=blocked
# Secret for signed report download links (empty = random per server start) and link lifetime.
# DOWNLOAD_LINK_SECRET=
# DOWNLOAD_LINK_TTL_HOURS=24
# Optional logo (PNG/JPEG path) for the PDF report header.
# REPORT_LOGO_PATH=

# ---------------------------------------------------------------------------------------
# Wave 2 (contract v3). OpenAI routes are NOT residency-approved (PoC only).
# ---------------------------------------------------------------------------------------
# Voice answers (MP3/WAV/M4A/OGG) transcribed by OpenAI (needs OPENAI_API_KEY). 0 = off.
# VOICE_ANSWERS=1
# OPENAI_TRANSCRIBE_MODEL=gpt-transcribe
# Claude -> OpenAI fallback for OCR / grading / voice mapping (needs OPENAI_API_KEY). 0 = off.
# gpt-4o has an announced shutdown of 2027-01-14: point LLM_FALLBACK_MODEL elsewhere before then.
# LLM_FALLBACK=1
# LLM_FALLBACK_MODEL=gpt-4o
# Demo switch: skip every Claude call so the fallback route runs (outage drill).
# LLM_SIMULATE_PRIMARY_OUTAGE=0
# Read-only LMS export (X-API-Key). LMS_API_KEY is an optional static key; keys created in
# the UI are stored only as SHA-256. Max rows per call (100-50000).
# LMS_API=1
# LMS_API_KEY=
# LMS_MAX_ROWS=5000
# Default hours for a logged intervention (0.5-40).
# INTERVENTION_DEFAULT_HOURS=3
